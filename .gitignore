# Raw datasets - fetched, never committed. See each task's data/README.md.
task1_llm/data/*
task2_sentiment/data/*
task3_gan/data/monet_jpg/*
task3_gan/data/photo_jpg/*
!**/.gitkeep
!**/README.md

# Per-member preprocessing output - never shared (brief, section 5)
*/**/data_processed/*
!*/**/data_processed/.gitkeep

# Model weights - ignored by default; reported checkpoints under GitHub's 100 MB limit are
# allow-listed below (brief: checkpoints/ holds the trained weights). Record IDs in results.md.
*/**/checkpoints/*
!*/**/checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors
!task1_llm/zoheb_waghu/checkpoints/t1_baseline_20260929-213500_best.pt
!task2_sentiment/zoheb_waghu/checkpoints/t2_m1_baseline_20260929-211318_best.pt
!task2_sentiment/zoheb_waghu/checkpoints/t2_m2_cnn_20260929-211446_best.pt
!task2_sentiment/zoheb_waghu/checkpoints/t2_m3_bilstm_attn_20260929-211521_best.pt
# Task 3: fp16 copy of the two generators (43 MB); the fp32 _final.pt is 108 MB, over the limit
!task3_gan/zoheb_waghu/checkpoints/t3_baseline_20260929-235720_generators_fp16.pt

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# OS
.DS_Store

# Session transcripts / AI assistant logs - never committed.
# The brief (section 8) requires the architecture decisions and analysis to be
# the member own work, so these stay outside the graded repo.
.claude/
WORKPLAN.md
chat_transcript*.md
*_transcript.md

# Task 3 periodic training previews (thousands of small images)
task3_gan/*/outputs/train_samples/

# Task 3 heavy outputs, all regenerated by src/infer.py from the committed generators.
# pred_A2B/ (300 images) is committed in full. Of pred_B2A/ (7,038 images, 222 MB) only the
# first 300 by file name are committed - exactly the set the evaluator scores - via `git add -f`.
task3_gan/*/outputs/cycle_A/
task3_gan/*/outputs/cycle_B/
task3_gan/*/outputs/images.zip
task3_gan/zoheb_waghu/outputs/pred_B2A/*
!task3_gan/zoheb_waghu/outputs/pred_B2A/.gitkeep

# Instructor's evaluation bundle (dataset copy, ~100 MB) - see task3_gan/data/README.md
Part3_export/
